# Copy to .env and fill in. NEVER commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=school.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://school.example.org
# Set to 0 only while testing locally without HTTPS
DJANGO_HTTPS=1
# Trust X-Forwarded-For for the IP shown in the activity log (only behind nginx)
DJANGO_TRUST_PROXY_HEADERS=1

DB_NAME=sundayschool
DB_USER=sundayschool
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Where uploaded student files are stored (must NOT be served directly by nginx)
MEDIA_ROOT=/var/lib/sundayschool/media

# Used by `manage.py seed` (optional; a random one is generated and printed if empty)
SEED_HEAD_PASSWORD=